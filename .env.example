# ===================================================
# HSMLE Portal Environment Variables Template
# Copy this file to .env and configure for local or production deployment
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT
# ===================================================

# Application Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///backend/data/hsmle.db

# Admin Credentials
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Enquiry & Notification Settings
HSMLE_ENQUIRY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# AI & Optional Services
OPENAI_API_KEY=
