# Separate 64-hexadecimal shared secret configured in Website Google Apps Script Project Settings:
GOOGLE_APPS_SCRIPT_SECRET=a3f9c12e8b7d4a6f91c0e5b2d8a7f3c6e4b9d1a0f8c2e5b7a6d3c9f1e0b4a8d2
EMAIL_FROM=info@hsmleindia.com
